   "source": [
    "import torch\n",
    "\n",
    "\n",
    "def pt(s: str):\n",
    "    k = s.index('=') + 1\n",
    "    print(s.replace('\\n', '\\n' + ' ' * k))\n",
    "\n",
    "\n",
    "x = torch.tensor(\n",
    "    [\n",
    "        [1, 2],\n",
    "        [3, 4],\n",
    "    ]\n",
    ")\n",
    "x"
   ]
  },
