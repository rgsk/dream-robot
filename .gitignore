# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv*/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --- jupytext ---
# .py is the committed source of truth; .ipynb is a disposable build artifact
# rebuilt with: jupytext --to ipynb --execute <file>.py
# *.ipynb

# --- generated artifacts (the git-bloat sources) ---
# datasets: recorded demos, potentially GBs of video frames
data/
datasets/
# per-run outputs: videos, checkpoints, rollouts
experiments/*/videos/
experiments/*/checkpoints/
experiments/*/rollouts/
checkpoints/
*.pt
*.ckpt
*.mp4
*.webm
outputs/

# NOTE: experiments/<id>/{config.yaml,results.json,notes.md} ARE committed --
# they are the matrix. Only the heavy artifacts above are ignored.

# --- sim backends ---
# Isaac and friends drop caches/logs next to the code
.isaac/
*.usd~
logs/
# MuJoCo writes this into whatever the cwd happens to be
MUJOCO_LOG.TXT

# --- editor / OS ---
.DS_Store
.vscode/settings.json

scratch/