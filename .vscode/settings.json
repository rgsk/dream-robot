{
    // --- type checking: the basedpyright extension for .py and notebooks ---
    // no second language server from the Python extension (it would start Jedi, Pylance not being installed).
    // Checker and Ruff config live in pyproject.toml ([tool.basedpyright], [tool.ruff]), not here
    "python.languageServer": "None",
    // the project's basedpyright (dev group), not the one bundled with the extension
    "basedpyright.importStrategy": "fromEnvironment",
    "basedpyright.analysis.diagnosticMode": "openFilesOnly",
    // --- Ruff: format and fix on save via ruffgrid (Ruff + grid packing; the project's .venv/bin/ruff,
    // pyproject.toml's [tool.ruff]). Replaces the Ruff extension: don't run both ---
    "[python]": {
        "editor.defaultFormatter": "rgsk.ruffgrid",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    // notebooks: notebook-wide, Ruff seeing the whole notebook (an import used in a later cell is used)
    "notebook.defaultFormatter": "rgsk.ruffgrid",
    "notebook.formatOnSave.enabled": true,
    "notebook.codeActionsOnSave": {
        // "notebook.source.fixAll": "explicit",
        "notebook.source.organizeImports": "explicit"
    },
    // this project's venv, not one inherited from another workspace (llm's)
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    // Testing panel + run buttons in the gutter
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests",
        // plain `pytest` runs tests/ only (testpaths); listed here for the gutter buttons
        "exercises",
        // don't swallow print() from passing tests -- the test explorer only
        // ever shows what pytest itself writes out
        "-rP"
    ],
    "files.readonlyInclude": {
        "**/*.jsonl": true,
        "**/*.log": true,
    },
    "problems.visibility": true,
}
