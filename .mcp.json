{
  "mcpServers": {
    "t7-pick-place-objects": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "dream_robot.agent.server",
        "--env",
        "robosuite/assorted_pick_place",
        "--viewer",
        "own",
        "--score-log",
        "scratch/agent/referee_t7.jsonl",
        "--clips-dir",
        "scratch/agent/clips",
        "--horizon-seconds",
        "300",
        "--all-objects"
      ],
      "env": {
        "MUJOCO_GL": "egl"
      }
    },
    "kitchen-coffee-mug": {
      "command": "envs/robocasa/.venv/bin/python",
      "args": [
        "-m",
        "dream_robot.agent.server",
        "--env",
        "robocasa/CoffeeSetupMug",
        "--viewer",
        "own",
        "--score-log",
        "scratch/kitchen/referee.jsonl",
        "--clips-dir",
        "scratch/kitchen/clips"
      ],
      "env": {
        "MUJOCO_GL": "egl"
      }
    },
    "kitchen-counter-to-sink": {
      "command": "envs/robocasa/.venv/bin/python",
      "args": [
        "-m",
        "dream_robot.agent.server",
        "--env",
        "robocasa/PickPlaceCounterToSink",
        "--viewer",
        "own",
        "--score-log",
        "scratch/kitchen/referee.jsonl",
        "--clips-dir",
        "scratch/kitchen/clips"
      ],
      "env": {
        "MUJOCO_GL": "egl"
      }
    },
    "dream-yam": {
      "command": "envs/dream_yam/.venv/bin/python",
      "args": [
        "-m",
        "dream_robot.sims.dream_yam.server",
        "--task",
        "Put the apple and the orange into the bowl, and the banana on the plate.",
        "--max-calls",
        "200",
        "--score-log",
        "scratch/dream1/referee.jsonl",
        "--clips-dir",
        "scratch/dream1/clips",
        "--viewer"
      ],
      "env": {
        "MUJOCO_GL": "egl"
      }
    }
  }
}
